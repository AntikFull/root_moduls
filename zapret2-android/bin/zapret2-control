cmd_diag_apps() {
  local list_file="$MODDIR/lists/apps_black.list"
  [ -f "$list_file" ] || list_file="$LISTS_DIR/apps_black.list"
  echo "============================================================"
  echo " ТЕЛЕМЕТРИЯ И ДИАГНОСТИКА APPS BLACK (4PDA & BLACKLIST APPS)"
  echo "============================================================"
  echo "1. ПАКЕТЫ И РАЗРЕШЁННЫЕ UID:"
  if [ -f "$list_file" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$list_file" 2>/dev/null | tr -d '\r' | while read -r item; do
      [ -n "$item" ] || continue
      case "$item" in
        *[!0-9]*)
          local u=""
          if [ -f /data/system/packages.list ]; then
            u=$(awk -v p="$item" '$1 == p { print $2; exit }' /data/system/packages.list 2>/dev/null)
          fi
          if [ -z "$u" ] && [ -d "/data/data/$item" ]; then
            u=$(stat -c %u "/data/data/$item" 2>/dev/null)
          fi
          if [ -z "$u" ] && command -v pm >/dev/null 2>&1; then
            u=$(pm list packages -U 2>/dev/null | awk -v p="package:$item" '$1 == p { split($2, a, ":"); print a[2]; exit }')
          fi
          echo "  - Пакет: $item -> UID: ${u:-НЕ НАЙДЕН}"
          ;;
        *)
          echo "  - Числовой UID: $item"
          ;;
      esac
    done
  else
    echo "  Список apps_black.list не найден!"
  fi

  echo ""
  echo "2. ТАБЛИЦА МАРШРУТИЗАЦИИ (11887 / AWG98 IPv4):"
  ip -4 route show table 11887 2>/dev/null || echo "  Таблица 11887 пуста"

  echo ""
  echo "3. СТАТУС ТУННЕЛЯ AWG98 (AmneziaWG):"
  if [ -x "$MODDIR/bin/awg" ]; then
    "$MODDIR/bin/awg" show awg98 2>/dev/null || echo "  Интерфейс awg98 не активен"
  fi

  echo ""
  echo "4. ПРАВИЛА IP RULE (IPv4):"
  ip -4 rule show 2>/dev/null | grep -E '11887|0x00040000' || echo "  Правила для 11887 не найдены"

  echo ""
  echo "5. ДЕМОН DNS (z2netd, AAAA-filter NODATA):"
  local zpid=$(cat "$MODDIR/state/z2netd.pid" 2>/dev/null)
  if [ -n "$zpid" ] && kill -0 "$zpid" 2>/dev/null; then
    echo "  z2netd: АКТИВЕН (PID: $zpid, порт: 5353, AAAA: BLOCKED)"
  else
    echo "  z2netd: НЕ ЗАПУЩЕН"
  fi

  echo ""
  echo "6. СЧЁТЧИКИ NETFILTER ДЛЯ APPS BLACK:"
  echo "-- Filter Killswitch & DoT Block:"
  iptables -w 5 -t filter -L ZAPRET2_APPS_KILL -nvx 2>/dev/null || echo "  Цепочка ZAPRET2_APPS_KILL отсутствует"
  echo "-- Nat DNS (Redirect to z2netd:5353):"
  iptables -w 5 -t nat -L ZAPRET2_APPS_DNS -nvx 2>/dev/null || echo "  Цепочка ZAPRET2_APPS_DNS отсутствует"

  echo ""
  echo "7. АКТИВНЫЕ СОКЕТЫ ЦЕЛЕВЫХ UID:"
  local uids=$(sh "$MODDIR/warp-tunnel.sh" get-apps-uids 2>/dev/null)
  if [ -n "$uids" ]; then
    for u in $uids; do
      echo "  UID $u активные подключения:"
      if command -v ss >/dev/null 2>&1; then
        ss -tupan 2>/dev/null | awk -v uid="$u" '$0 ~ ("uid:" uid) { print "    " $0 }'
      else
        netstat -tupan 2>/dev/null | grep "$u" | sed 's/^/    /' || echo "    нет соединений"
      fi
    done
  fi
  echo "============================================================"
}

cmd_json_connectivity() {
  local curl_bin="$MODDIR/bin/curl"
  [ -x "$curl_bin" ] || curl_bin="curl"

  check_target() {
    local url="$1"
    local start_ts end_ts res time_total
    start_ts=$(date +%s%3N 2>/dev/null || date +%s000 2>/dev/null)
    if "$curl_bin" -s -k -L -m 4 --connect-timeout 3 -o /dev/null -w "%{http_code}" "$url" >/dev/null 2>&1; then
      end_ts=$(date +%s%3N 2>/dev/null || date +%s000 2>/dev/null)
      time_total=$((end_ts - start_ts))
      [ "$time_total" -le 0 ] && time_total=15
      echo "{\"status\":\"ok\",\"latency_ms\":$time_total}"
    else
      echo "{\"status\":\"error\",\"latency_ms\":0}"
    fi
  }

  local yt disc fpda cf tg
  yt=$(check_target "https://www.youtube.com/generate_204")
  disc=$(check_target "https://discord.com/api/v9/gateway")
  fpda=$(check_target "https://4pda.to")
  cf=$(check_target "https://crypto.cloudflare.com")
  tg=$(check_target "https://web.telegram.org")

  printf '{"youtube":%s,"discord":%s,"fourpda":%s,"cloudflare_ech":%s,"telegram":%s}\n' \
    "$yt" "$disc" "$fpda" "$cf" "$tg"
}

case "$1" in
  status) cmd_status ;;
  json-status) cmd_json_status ;;
  json-connectivity|test-connectivity) cmd_json_connectivity ;;
  service-start|start) cmd_service_start ;;
  service-stop|stop) cmd_service_stop ;;
  json-hotspot-settings) cmd_json_hotspot_settings ;;
  json-strategies) cmd_json_strategies ;;
  json-diagnostics) cmd_json_diagnostics ;;
  json-hostlist) cmd_json_hostlist ;;
  json-learned) cmd_json_learned "$@" ;;
  hostlist-mode) cmd_hostlist_mode "$@" ;;
  hostlist-clear) cmd_hostlist_clear ;;
  json-warp-status) cmd_json_warp_status ;;
  warp-toggle) cmd_warp_toggle "$@" ;;
  warp-rekey) cmd_warp_rekey ;;
  warp-restart) cmd_warp_restart ;;
  awg99-restart|restart-ru) cmd_awg99_restart ;;
  awg99-stop|stop-ru) cmd_awg99_stop ;;
  awg99-start|start-ru) cmd_awg99_start ;;
  awg98-restart|restart-geo) cmd_awg98_restart ;;
  awg98-stop|stop-geo) cmd_awg98_stop ;;
  awg98-start|start-geo) cmd_awg98_start ;;
  awg98-rotate|rotate-geo) cmd_awg98_rotate ;;
  forcetcp) validate_switch "$2" || exit 1; set_conf FORCE_TCP "$2"; reload_service ;;
  quicmode) case "$2" in off|on) set_conf QUIC_MODE "$(echo "$2" | tr '[:lower:]' '[:upper:]')"; reload_service ;; *) exit 1 ;; esac ;;
  hotspot-settings) cmd_hotspot_settings "$@" ;;
  save-smart) cmd_save_smart "$@" ;;
  save-strategies) cmd_save_strategies "$@" ;;
  replace-list) cmd_replace_list "$2" "$3" ;;
  replace-list-b64) cmd_replace_list_b64 "$2" "$3" ;;
  nfqws-debug) cmd_nfqws_debug "$@" ;;
  diag) cmd_diag ;;
  diag-apps) cmd_diag_apps ;;
  export-logs) cmd_export_logs ;;
  module-version) cmd_module_version ;;
  auto-status) cmd_auto_status ;;
  auto-run) cmd_auto_run ;;
  auto-clear) cmd_auto_clear ;;
  restart) reload_service ;;
  webui) cmd_webui ;;
  log) cmd_tail_log "$LOG_FILE" "$2" ;;
  nfqws-log) cmd_tail_log "$NFQWS_LOG" "$2" ;;
  *) echo "Команды: status, json-status, json-warp-status, diag-apps, awg99-restart, awg98-restart, restart, diag, export-logs, log, nfqws-log" ;;
esac
