#!/system/bin/sh
umask 077

SELF_DIR="${0%/*}"
case "$SELF_DIR" in /*) ;; *) SELF_DIR="$(pwd)/$SELF_DIR" ;; esac
MODDIR="${SELF_DIR%/bin}"
[ -f "$MODDIR/module.prop" ] || MODDIR="/data/adb/modules/zapret2-android"
CONF_FILE="$MODDIR/zapret2.conf"
: "${STATE_DIR:=$MODDIR/state}"
LISTS_DIR="$MODDIR/lists"
[ -d "$LISTS_DIR" ] || LISTS_DIR="$MODDIR"
USER_DOMAINS_FILE="$LISTS_DIR/user.list"
IPSET_FILE="$LISTS_DIR/ipset.list"
IPSET_EXCLUDE_FILE="$LISTS_DIR/ipset_exclude.list"
WARP_DOMAINS_FILE="$LISTS_DIR/warp_domains.list"
WARP_BYPASS_NETS_FILE="$LISTS_DIR/warp_bypass_nets.list"
EXCLUDE_DOMAINS_FILE="$LISTS_DIR/exclude_domains.list"
LOG_DIR="$MODDIR/logs"
LOG_FILE="$LOG_DIR/zapret2_debug.log"
NFQWS_LOG="$LOG_DIR/zapret2_nfqws.log"
EXPORT_LOG_DIR="/sdcard/eCubz"
RUN_DIR="$MODDIR/run"
HEALTH_FILE="$RUN_DIR/health.env"
START_STATE_FILE="$RUN_DIR/startup.env"
AUTO_RESULT_FILE="$RUN_DIR/auto-current.env"
STRATEGY_DIR="$MODDIR/strategies"
STRATEGY_LIB="$MODDIR/strategy-lib.sh"
[ -f "$STRATEGY_LIB" ] && . "$STRATEGY_LIB"
PACKAGE_UID_CACHE="$RUN_DIR/package_uids.cache"
CONTROL_WRITE_MARK="$RUN_DIR/control-write.ts"
LATE_START_PID_FILE="$RUN_DIR/late-start.pid"
mkdir -p "$RUN_DIR" "$LOG_DIR" 2>/dev/null
chmod 0700 "$RUN_DIR" "$LOG_DIR" 2>/dev/null || true

load_conf() { [ -f "$CONF_FILE" ] && . "$CONF_FILE"; }

# ------------------------------------------------------------------------------
# Перезапуск службы.
#
# Из CGI (WebUI) reload обязан быть асинхронным: полный цикл — это probe_firewall,
# пересборка UID и рестарт nfqws2, то есть десятки секунд, в течение которых
# HTTP-запрос висел бы и отваливался по таймауту. Прогресс WebUI читает из
# run/startup.env (STATE/PHASE/PROGRESS), который service.sh обновляет по ходу.
#
# Из CLI reload остаётся синхронным, чтобы `zapret2-control restart` возвращал
# осмысленный код завершения.
# ------------------------------------------------------------------------------
spawn_detached() {
  if command -v setsid >/dev/null 2>&1; then
    setsid "$@" </dev/null >/dev/null 2>&1 &
  elif command -v busybox >/dev/null 2>&1 && busybox setsid true >/dev/null 2>&1; then
    busybox setsid "$@" </dev/null >/dev/null 2>&1 &
  else
    nohup "$@" </dev/null >/dev/null 2>&1 &
  fi
}
reload_service() {
  if [ "${Z2_ASYNC:-0}" = "1" ]; then
    # Помечаем состояние сразу, чтобы WebUI показал «Перезапуск» ещё до того,
    # как service.sh успеет перехватить блокировку и записать свой прогресс.
    mkdir -p "$RUN_DIR" 2>/dev/null
    {
      printf 'STATE=STARTING\n'
      printf 'PHASE=%s\n' "Применение настроек"
      printf 'PROGRESS=5\n'
      printf 'UPDATED=%s\n' "$(date +%s 2>/dev/null)"
    } > "$START_STATE_FILE.tmp.$$" 2>/dev/null && mv -f "$START_STATE_FILE.tmp.$$" "$START_STATE_FILE" 2>/dev/null
    chmod 0600 "$START_STATE_FILE" 2>/dev/null || true
    spawn_detached sh "$MODDIR/service.sh" reload
    return 0
  fi
  sh "$MODDIR/service.sh" reload
}

validate_pkg() { case "$1" in *[!A-Za-z0-9_.]*|'') return 1 ;; *) return 0 ;; esac; }
validate_switch() { [ "$1" = 0 ] || [ "$1" = 1 ]; }
validate_vpn_fallback() { [ "$1" = ANTIDPI ] || [ "$1" = BLOCK ]; }
validate_tun_name() { case "$1" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; *) return 0 ;; esac; }
validate_ipv4() {
  local ip="$1" a b c d extra o
  IFS=. read -r a b c d extra <<EOV
$ip
EOV
  [ -z "$extra" ] || return 1
  for o in "$a" "$b" "$c" "$d"; do
    case "$o" in ''|*[!0-9]*) return 1 ;; esac
    [ "$o" -ge 0 ] 2>/dev/null && [ "$o" -le 255 ] 2>/dev/null || return 1
  done
}
validate_dns_servers() {
  [ -n "$1" ] || return 1
  for dns_server in $1; do validate_ipv4 "$dns_server" || return 1; done
}
validate_strategy_args() {
  [ -n "$1" ] && [ "${#1}" -le 4096 ] || return 1
  printf '%s' "$1" | LC_ALL=C grep -Eq '^[-A-Za-z0-9_.,:=/@+% /]+$'
}
# Зомби и умирающие процессы не отдают cmdline: ядро держит блокировку памяти
# задачи, и чтение виснет без таймаута. /proc/PID/stat читается без неё, поэтому
# сначала спрашиваем состояние. Полный вариант с потолком по времени — в
# service.sh; здесь достаточно отсечь мёртвые PID.
pid_cmdline() {
  local st
  case "$1" in ''|0|*[!0-9]*) return 1 ;; esac
  st=$(sed -n 's/.*) //p' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f1)
  case "$st" in ''|Z|X|x) return 1 ;; esac
  tr '\000' ' ' < "/proc/$1/cmdline" 2>/dev/null
}
pid_is_nfqws() {
  local pid="$1" cwd comm
  case "$pid" in ''|0|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  comm=$(cat "/proc/$pid/comm" 2>/dev/null)
  cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null)
  [ "$comm" = nfqws2 ] && [ "$cwd" = "$MODDIR/bin" ]
}
pid_is_script() {
  local pid="$1" script="$2" cmd
  case "$pid" in ''|0|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  cmd=$(pid_cmdline "$pid")
  printf '%s' "$cmd" | grep -Fq "$MODDIR/$script"
}
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/\\n/g'; }

run_with_timeout() {
  local limit="$1" pid elapsed=0 rc
  shift
  case "$limit" in ''|*[!0-9]*) limit=2 ;; esac
  [ "$limit" -ge 1 ] 2>/dev/null || limit=1
  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$elapsed" -ge "$limit" ] 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      sleep 1
      kill -9 "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  wait "$pid"
  rc=$?
  return "$rc"
}

mark_control_write() { mkdir -p "$RUN_DIR" 2>/dev/null; date +%s > "$CONTROL_WRITE_MARK" 2>/dev/null; }
validate_conf_value() {
  [ "${#1}" -le 8192 ] || return 1
  case "$1" in *'
'*|*'
'*|*'"'*|*"'"*|*'`'*|*'$'*|*'\'*) return 1 ;; esac
  # Reject ASCII control bytes except ordinary spaces/tabs.
  printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
  return 0
}
set_conf() {
  local key="$1" value="$2"
  case "$key" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
  validate_conf_value "$value" || { echo "Некорректное значение для $key" >&2; return 1; }
  mark_control_write
  local tmp="$CONF_FILE.tmp.$$"
  awk -v k="$key" -v v="$value" '
    BEGIN { done=0 }
    $0 ~ "^[[:space:]]*" k "=" { print k "=\"" v "\""; done=1; next }
    { print }
    END { if (!done) print k "=\"" v "\"" }
  ' "$CONF_FILE" > "$tmp" && mv -f "$tmp" "$CONF_FILE" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$CONF_FILE" 2>/dev/null || true
}

# Списки, которые можно заменить целиком через WebUI. Только домены и подсети:
# отбор по приложениям из модуля убран.
list_file() {
  case "$1" in
    domains) echo "$USER_DOMAINS_FILE" ;;
    exclude-domains) echo "$EXCLUDE_DOMAINS_FILE" ;;
    ipset) echo "$IPSET_FILE" ;;
    ipset-exclude) echo "$IPSET_EXCLUDE_FILE" ;;
    warp-domains) echo "$WARP_DOMAINS_FILE" ;;
    geo-warp|geo-domains) echo "$MODDIR/lists/geo_warp.list" ;;
    warp-nets) echo "$WARP_BYPASS_NETS_FILE" ;;
    apps-black|apps_black|apps) echo "$MODDIR/lists/apps_black.list" ;;
    *) return 1 ;;
  esac
}

health_value() { sed -n "s/^$1=//p" "$HEALTH_FILE" 2>/dev/null | head -n1; }
startup_value() { sed -n "s/^$1=//p" "$START_STATE_FILE" 2>/dev/null | head -n1; }

cmd_status() {
  load_conf
  local pid=0 state="остановлен" health warnings effective
  [ -f "$RUN_DIR/nfqws2.pid" ] && pid=$(cat "$RUN_DIR/nfqws2.pid" 2>/dev/null)
  if [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && pid_is_nfqws "$pid"; then
    state="работает"
  elif [ -f "$RUN_DIR/direct.flag" ]; then
    state="прямое подключение (DIRECT)"
    pid=0
  else
    pid=0
  fi
  health=$(health_value HEALTH); warnings=$(health_value WARNINGS); effective=$(health_value STRATEGY_EFFECTIVE)
  echo "Zapret2: $state (PID: ${pid:-0}) health=${health:-UNKNOWN}"
  echo "Домены=${HOSTLIST_MODE:-AUTO}, STRATEGY=${STRATEGY_MODE:-SMART}->${effective:-${STRATEGY_MODE:-SMART}}, FORCE_TCP=${FORCE_TCP:-1}, QUIC=${QUIC_MODE:-ON}"
  [ -n "$warnings" ] && echo "WARNINGS: $warnings"
}

cmd_json_status() {
  load_conf
  local pid=0 running=false direct=false health warnings effective compat compat_notes         user_domains=0 learned=0 ipset_nets=0 ipset_excl=0 excl_domains=0         startup_state startup_phase startup_progress startup_updated now age         late_start_pid late_start_waiting=false downstream vpn_iface vpn_meta vpn_mode         vpn_watcher_pid health_watcher_pid vpn_watcher_alive=false health_watcher_alive=false         auto_profile auto_status auto_network_iface auto_network_key auto_updated         acct connbytes4 connmark4 nfq4 mod_ver
  [ -f "$RUN_DIR/nfqws2.pid" ] && pid=$(cat "$RUN_DIR/nfqws2.pid" 2>/dev/null)
  [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && pid_is_nfqws "$pid" && running=true || pid=0
  if [ -f "$RUN_DIR/direct.flag" ]; then direct=true; running=true; pid=0; fi

  # grep -c печатает 0 сам, но при отсутствующем файле не печатает ничего,
  # а пустое значение сломало бы числовое поле JSON.
  count_lines() {
    local n
    n=$(grep -cvE '^[[:space:]]*(#|$)' "$1" 2>/dev/null)
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    printf '%s' "$n"
  }
  user_domains=$(count_lines "$USER_DOMAINS_FILE")
  learned=$(count_lines "$MODDIR/state/auto.list")
  ipset_nets=$(count_lines "$IPSET_FILE")
  ipset_excl=$(count_lines "$IPSET_EXCLUDE_FILE")
  excl_domains=$(count_lines "$EXCLUDE_DOMAINS_FILE")

  health=$(health_value HEALTH); [ -n "$health" ] || health=UNKNOWN
  warnings=$(health_value WARNINGS); effective=$(health_value STRATEGY_EFFECTIVE)
  compat=$(health_value COMPAT_STATUS); compat_notes=$(health_value COMPAT_NOTES)
  auto_profile=$(health_value AUTO_PROFILE); auto_status=$(health_value AUTO_STATUS)
  auto_network_key=$(health_value AUTO_NETWORK_KEY); auto_network_iface=$(health_value AUTO_NETWORK_IFACE)
  auto_updated=$(health_value AUTO_UPDATED)
  acct=$(health_value CONNTRACK_ACCT); connbytes4=$(health_value CONNBYTES4)
  connmark4=$(health_value CONNMARK4); nfq4=$(health_value NFQUEUE4)
  [ -n "$effective" ] || effective=${STRATEGY_MODE:-SMART}
  [ -n "$compat" ] || compat=NATIVE

  startup_state=$(startup_value STATE); startup_phase=$(startup_value PHASE)
  startup_progress=$(startup_value PROGRESS); startup_updated=$(startup_value UPDATED)
  [ -n "$startup_state" ] || startup_state=IDLE
  [ -n "$startup_progress" ] || startup_progress=0
  case "$startup_updated" in ''|*[!0-9]*) startup_updated=0 ;; esac
  now=$(date +%s 2>/dev/null); case "$now" in ''|*[!0-9]*) now=0 ;; esac
  age=$((now-startup_updated))
  late_start_pid=$(cat "$LATE_START_PID_FILE" 2>/dev/null)
  case "$late_start_pid" in ''|0|*[!0-9]*) ;; *) pid_is_script "$late_start_pid" service.sh && late_start_waiting=true ;; esac

  # Именно "cat file 2>/dev/null | tr", а не "tr < file": об ошибке открытия при
  # перенаправлении сообщает сам shell, и 2>/dev/null её не перехватывает.
  # api.sh забирает stderr в тело ответа, поэтому такая строка ломала бы JSON
  # каждый раз, когда раздачей ни разу не пользовались и файла состояния нет.
  downstream=$(cat "$RUN_DIR/tether-downstreams.state" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')
  vpn_meta=$(cat "$RUN_DIR/vpn-routing.meta" 2>/dev/null)
  vpn_iface=$(printf '%s' "$vpn_meta" | sed -n 's/^.*|vpn=\([^|]*\).*$/\1/p')
  if [ -z "$downstream" ]; then vpn_mode=IDLE; else case "$vpn_meta" in disabled) vpn_mode=OFF ;; *'|vpn=|'*) [ "${VPN_FALLBACK_MODE:-ANTIDPI}" = BLOCK ] && vpn_mode=BLOCK || vpn_mode=ANTIDPI ;; *'|vpn='*) vpn_mode=VPN ;; *) vpn_mode=IDLE ;; esac; fi
  vpn_watcher_pid=$(cat "$RUN_DIR/vpn-watcher.pid" 2>/dev/null); case "$vpn_watcher_pid" in ''|0|*[!0-9]*) ;; *) pid_is_script "$vpn_watcher_pid" vpn-watch.sh && vpn_watcher_alive=true ;; esac
  health_watcher_pid=$(cat "$RUN_DIR/health-watcher.pid" 2>/dev/null); case "$health_watcher_pid" in ''|0|*[!0-9]*) ;; *) pid_is_script "$health_watcher_pid" service-watch.sh && health_watcher_alive=true ;; esac

  if [ "$running" = true ]; then startup_state=READY; startup_phase="Служба работает"; startup_progress=100
  elif [ "$startup_state" = WAITING ] && [ "$late_start_waiting" = true ]; then startup_phase="Ожидание завершения загрузки Android"
  elif { [ "$startup_state" = STARTING ] || [ "$startup_state" = WAITING ]; } && [ "$age" -gt 120 ] 2>/dev/null; then startup_state=STALE; startup_phase="Перезапуск не завершён за 2 минуты"; fi

  mod_ver=$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n1)
  [ -n "$mod_ver" ] || mod_ver="unknown"
  printf '{"version":"%s","running":%s,"direct":%s,"pid":%s,"force_tcp":"%s","quic_mode":"%s","hostlist_mode":"%s","user_domains":%s,"learned_domains":%s,"exclude_domains":%s,"ipset_nets":%s,"ipset_exclude_nets":%s,"health":"%s","warnings":"%s","strategy":"%s","strategy_effective":"%s","compat_status":"%s","compat_notes":"%s","auto_profile":"%s","auto_status":"%s","auto_network_key":"%s","auto_network_iface":"%s","auto_updated":"%s","cap_acct":"%s","cap_connbytes":"%s","cap_connmark":"%s","cap_nfqueue":"%s","startup_state":"%s","startup_phase":"%s","startup_progress":%s,"startup_updated":%s,"tether_downstream":"%s","vpn_iface":"%s","vpn_mode":"%s","vpn_watcher_alive":%s,"health_watcher_alive":%s}\n'     "$(json_escape "$mod_ver")" "$running" "$direct" "$pid" "${FORCE_TCP:-1}" "${QUIC_MODE:-ON}"     "$(json_escape "${HOSTLIST_MODE:-AUTO}")" "$user_domains" "$learned" "$excl_domains" "$ipset_nets" "$ipset_excl"     "$(json_escape "$health")" "$(json_escape "$warnings")" "$(json_escape "${STRATEGY_MODE:-SMART}")" "$(json_escape "$effective")"     "$(json_escape "$compat")" "$(json_escape "$compat_notes")" "$(json_escape "${auto_profile:-UNKNOWN}")" "$(json_escape "${auto_status:-UNKNOWN}")"     "$(json_escape "${auto_network_key:-none}")" "$(json_escape "${auto_network_iface:-none}")" "${auto_updated:-0}"     "${acct:-0}" "${connbytes4:-0}" "${connmark4:-0}" "${nfq4:-0}"     "$(json_escape "$startup_state")" "$(json_escape "$startup_phase")" "$startup_progress" "$startup_updated"     "$(json_escape "$downstream")" "$(json_escape "$vpn_iface")" "$(json_escape "$vpn_mode")" "$vpn_watcher_alive" "$health_watcher_alive"
}


cmd_json_hotspot_settings() {
  load_conf
  printf '{"enable_hotspot":"%s","enable_vpn_hotspot":"%s","vpn_tun_name":"%s","vpn_fallback_mode":"%s","force_tcp_hotspot":"%s","dns_forward_hotspot":"%s","dns_forward_servers":"%s"}\n' \
    "${ENABLE_HOTSPOT:-1}" "${ENABLE_VPN_HOTSPOT:-0}" "${VPN_TUN_NAME:-AUTO}" "${VPN_FALLBACK_MODE:-ANTIDPI}" "${FORCE_TCP_HOTSPOT:-1}" "${DNS_FORWARD_HOTSPOT:-0}" "${DNS_FORWARD_SERVERS:-${DNS_FORWARD_SERVER:-1.1.1.1}}"
}

cmd_json_strategies() {
  load_conf
  local effective compat auto_profile auto_profile_name auto_status auto_iface auto_updated strategy_count strategy_order number id path
  effective=$(health_value STRATEGY_EFFECTIVE); [ -n "$effective" ] || effective=${STRATEGY_MODE:-SMART}
  compat=$(health_value COMPAT_STATUS); [ -n "$compat" ] || compat=NATIVE
  auto_profile=$(health_value AUTO_PROFILE); auto_profile_name=$(health_value AUTO_PROFILE_NAME); auto_status=$(health_value AUTO_STATUS); auto_iface=$(health_value AUTO_NETWORK_IFACE); auto_updated=$(health_value AUTO_UPDATED)
  strategy_list | while IFS='|' read -r number id path; do
    strategy_read "$id" || continue
    printf '%s|%s\n' "$id" "$STRATEGY_FILE_NAME"
  done > "$RUN_DIR/strategy-order.$$"
  strategy_count=$(wc -l < "$RUN_DIR/strategy-order.$$" 2>/dev/null); strategy_count=${strategy_count:-0}
  strategy_order=$(awk -F'|' 'BEGIN{s=""} {s=s (s?" > ":"") $1 "/" $2} END{print s}' "$RUN_DIR/strategy-order.$$" 2>/dev/null)
  rm -f "$RUN_DIR/strategy-order.$$" 2>/dev/null
  printf '{"active":"%s","engine":"%s","compat_status":"%s","auto_profile":"%s","auto_profile_name":"%s","auto_status":"%s","auto_iface":"%s","auto_updated":"%s","strategy_count":%s,"strategy_order":"%s","compat_general":"%s","native_general":"%s","custom":"%s"}\n' \
    "${STRATEGY_MODE:-SMART}" "$(json_escape "$effective")" "$(json_escape "$compat")" "$(json_escape "${auto_profile:-UNKNOWN}")" "$(json_escape "${auto_profile_name:-UNKNOWN}")" "$(json_escape "${auto_status:-UNKNOWN}")" "$(json_escape "${auto_iface:-none}")" "${auto_updated:-0}" "$strategy_count" "$(json_escape "$strategy_order")" \
    "$(json_escape "${DESYNC_ARGS_SMART_COMPAT_GENERAL:-}")" \
    "$(json_escape "${DESYNC_ARGS_SMART_NATIVE_GENERAL:-}")" "$(json_escape "${DESYNC_ARGS_CUSTOM:-}")"
}

cmd_save_smart() {
  local mode="$2" custom="$3"
  case "$mode" in SMART|CUSTOM) ;; *) return 1 ;; esac
  [ "$mode" != CUSTOM ] || validate_strategy_args "$custom" || return 1
  set_conf STRATEGY_MODE "$mode"
  [ "$mode" != CUSTOM ] || set_conf DESYNC_ARGS_CUSTOM "$custom"
  reload_service
}

cmd_save_strategies() {
  local mode="$2"
  case "$mode" in SIMPLE|AUTO|SMART) mode=SMART ;; CUSTOM) mode=CUSTOM ;; *) return 1 ;; esac
  [ -z "$5" ] || validate_strategy_args "$5" || return 1
  set_conf STRATEGY_MODE "$mode"
  [ "$mode" != CUSTOM ] || set_conf DESYNC_ARGS_CUSTOM "$5"
  reload_service
}

cmd_hotspot_settings() {
  validate_switch "$2" && validate_switch "$3" && validate_tun_name "$4" && validate_vpn_fallback "$5" && validate_switch "$6" && validate_switch "$7" || return 1
  dns_value="$8"
  if [ "$7" = 1 ]; then
    validate_dns_servers "$dns_value" || return 1
  elif [ -z "$dns_value" ]; then
    load_conf
    dns_value=${DNS_FORWARD_SERVERS:-${DNS_FORWARD_SERVER:-1.1.1.1}}
  else
    validate_dns_servers "$dns_value" || return 1
  fi
  set_conf ENABLE_HOTSPOT "$2"; set_conf ENABLE_VPN_HOTSPOT "$3"; set_conf VPN_TUN_NAME "$4"; set_conf VPN_FALLBACK_MODE "$5"; set_conf VPN_HOTSPOT_KILLSWITCH 0; set_conf FORCE_TCP_HOTSPOT "$6"; set_conf DNS_FORWARD_HOTSPOT "$7"; set_conf DNS_FORWARD_SERVERS "$dns_value"
  reload_service
}








# Полная замена одного из списков. Все списки теперь текстовые: домены или
# подсети, по одной записи на строку. Разрешены только символы, встречающиеся в
# именах доменов и в записи CIDR, плюс комментарии — так значение не может стать
# ни shell-конструкцией, ни аргументом nfqws2.
cmd_replace_list() {
  local list="$1" input="$2" file tmp line kind
  file=$(list_file "$list") || { echo "Неизвестный список: $list" >&2; return 1; }
  case "$list" in
    ipset|ipset-exclude|warp-nets) kind=net ;;
    apps-black|apps_black|apps) kind=pkg ;;
    *) kind=domain ;;
  esac
  tmp="$RUN_DIR/list_replace.$$.tmp"; : > "$tmp" || return 1
  printf '%s\n' "$input" | while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*) echo "$line"; continue ;;
    esac
    if [ "$kind" = net ]; then
      case "$line" in *[!0-9A-Fa-f.:/\ \#-]*) exit 1 ;; esac
    elif [ "$kind" = pkg ]; then
      validate_pkg "$line" || exit 1
    else
      case "$line" in *[!A-Za-z0-9._*\ \#-]*) exit 1 ;; esac
    fi
    echo "$line"
  done > "$tmp" || { rm -f "$tmp"; echo "Недопустимая строка в списке" >&2; return 1; }
  mark_control_write
  mkdir -p "$LISTS_DIR" 2>/dev/null
  mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
  chmod 0644 "$file" 2>/dev/null || true
  case "$list" in
    warp-domains|warp-nets|geo-warp|geo-domains|apps-black|apps_black|apps)
      # Маршрутизация туннелей перестраивается без перезапуска nfqws2.
      sh "$MODDIR/warp-tunnel.sh" sync-dest-rules >/dev/null 2>&1 || true
      echo '{"ok":true,"applied":"warp"}' ;;
    *)
      reload_service
      echo '{"ok":true,"applied":"service"}' ;;
  esac
}

cmd_replace_list_b64() {
  local list="$1" b64="$2" decoded
  decoded=$(printf '%s' "$b64" | base64 -d 2>/dev/null)
  cmd_replace_list "$list" "$decoded"
}

cmd_json_diagnostics() {
  load_conf
  printf '{"nfqws_debug":"%s","service_log":"%s","nfqws_log":"%s","diag_file":"%s","export_dir":"%s"}\n' "${NFQWS_DEBUG:-0}" "$LOG_FILE" "$NFQWS_LOG" "$LOG_DIR/zapret2_diagnostics_latest.txt" "$EXPORT_LOG_DIR"
}
cmd_nfqws_debug() {
  validate_switch "$2" || return 1
  if [ "$2" = 1 ]; then
    [ -f "$NFQWS_LOG" ] && mv -f "$NFQWS_LOG" "$NFQWS_LOG.previous" 2>/dev/null
    : > "$NFQWS_LOG" 2>/dev/null
  fi
  set_conf NFQWS_DEBUG "$2"
  reload_service
  [ "$2" = 1 ] && echo "nfqws debug включён: $NFQWS_LOG" || echo "nfqws debug выключен"
}
cmd_diag() { sh "$MODDIR/diagnostics.sh"; }
cmd_export_logs() { sh "$MODDIR/log-export.sh" now; }
cmd_module_version() { sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n1; }
cmd_auto_status() { sh "$MODDIR/auto-select.sh" status; }
cmd_auto_run() { sh "$MODDIR/auto-select.sh" force; }
cmd_auto_clear() { sh "$MODDIR/auto-select.sh" clear; sh "$MODDIR/service.sh" reload; }
cmd_webui() { echo "WebUI открывается менеджером root из webroot/index.html"; }

# ------------------------------------------------------------------------------
# Доменные списки (терминология nfqws2-keenetic)
# ------------------------------------------------------------------------------
USER_DOMAINS_FILE="$LISTS_DIR/user.list"
LEARNED_DOMAINS_FILE="$MODDIR/state/auto.list"

cmd_json_hostlist() {
  load_conf
  local mode user_count learned_count
  mode=$(health_value HOSTLIST_MODE); [ -n "$mode" ] || mode="${HOSTLIST_MODE:-AUTO}"
  user_count=$(grep -cvE '^[[:space:]]*(#|$)' "$USER_DOMAINS_FILE" 2>/dev/null)
  learned_count=$(grep -cvE '^[[:space:]]*(#|$)' "$LEARNED_DOMAINS_FILE" 2>/dev/null)
  printf '{"mode":"%s","user_domains":%s,"learned_domains":%s,"fail_threshold":"%s","fail_time":"%s"}\n' \
    "$(json_escape "$mode")" "${user_count:-0}" "${learned_count:-0}" \
    "${HOSTLIST_AUTO_FAIL_THRESHOLD:-3}" "${HOSTLIST_AUTO_FAIL_TIME:-60}"
}

# Список выученных доменов для показа в WebUI. Файл пишет сам nfqws2.
cmd_json_learned() {
  local line first=1 n=0 limit="${2:-500}"
  case "$limit" in ''|*[!0-9]*) limit=500 ;; esac
  printf '['
  if [ -f "$LEARNED_DOMAINS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line=$(printf '%s' "$line" | tr -d '[:space:]')
      case "$line" in ''|\#*) continue ;; esac
      case "$line" in *[!A-Za-z0-9.*_-]*) continue ;; esac
      [ "$n" -lt "$limit" ] || break
      [ "$first" = 1 ] || printf ','
      first=0; n=$((n + 1))
      printf '"%s"' "$line"
    done < "$LEARNED_DOMAINS_FILE"
  fi
  printf ']\n'
}

cmd_hostlist_mode() {
  case "$2" in
    LIST|AUTO|ALL) ;;
    list|auto|all) set -- "$1" "$(echo "$2" | tr '[:lower:]' '[:upper:]')" ;;
    *) echo "Режим должен быть LIST, AUTO или ALL" >&2; return 1 ;;
  esac
  set_conf HOSTLIST_MODE "$2" || return 1
  reload_service
}

# Сброс обучения: домены накапливаются годами и могут устареть после того,
# как провайдер снял блокировку.
cmd_hostlist_clear() {
  mkdir -p "${LEARNED_DOMAINS_FILE%/*}" 2>/dev/null
  : > "$LEARNED_DOMAINS_FILE" 2>/dev/null || { echo "Не удалось очистить список выученных доменов" >&2; return 1; }
  chmod 0600 "$LEARNED_DOMAINS_FILE" 2>/dev/null || true
  reload_service
  echo '{"ok":true,"learned_domains":0}'
}

# Число строк приходит из HTTP-параметра, поэтому подставлять его в tail без
# проверки нельзя: значение вроде "-f" превратило бы чтение лога в бесконечный
# поток и подвесило бы CGI-процесс.
cmd_tail_log() {
  local file="$1" lines="$2"
  case "$lines" in ''|*[!0-9]*) lines=150 ;; esac
  [ "$lines" -ge 1 ] 2>/dev/null || lines=150
  [ "$lines" -le 5000 ] 2>/dev/null || lines=5000
  tail -n "$lines" "$file" 2>/dev/null
}

cmd_json_warp_status() {
  load_conf
  export WG_UAPI_DIR="/dev/wireguard"
  export AMNEZIAWG_UAPI_DIR="/dev/wireguard"
  local dev="${WARP_DEV:-awg99}" table="${WARP_ROUTE_TABLE:-11888}" enabled="${ENABLE_WARP:-0}"
  local running=false interface_up=false routing_ok=false rules_ok=true endpoint="" rx_bytes=0 tx_bytes=0 last_handshake=0 warp_domains_count=0 active_dns=""
  local warp_domains_file="$LISTS_DIR/warp_domains.list" state_file="$MODDIR/state/warp-domain-ips.state"
  local warp_conf="$MODDIR/state/warp.conf" adapt_file="$MODDIR/state/warp-adapt.state"
  local active_jc="${WARP_JC:-5}" active_jmin="${WARP_JMIN:-40}" active_jmax="${WARP_JMAX:-70}" adapt_step=0 adapt_mode=basic
  local adapt_result=pending adapt_updated=0 adapt_total=40 handshake_age=-1 now
  warp_domains_count=$(awk '!/^[[:space:]]*(#|$)/ {n++} END {print n+0}' "$warp_domains_file" 2>/dev/null || echo 0)
  warp_domains_count=$((warp_domains_count + $(awk '!/^[[:space:]]*(#|$)/ {n++} END {print n+0}' "$MODDIR/state/warp_auto_domains.list" 2>/dev/null || echo 0)))

  local dns_file="$LISTS_DIR/dns.list"
  [ -f "$dns_file" ] || dns_file="$MODDIR/dns.list"
  if [ -f "$dns_file" ]; then active_dns=$(grep -vE '^[[:space:]]*(#|$)' "$dns_file" 2>/dev/null | tr '\r\n' ' ' | tr -s ' ' | sed 's/^ //;s/ $//'); fi
  [ -n "$active_dns" ] || active_dns="${WARP_DNS:-1.1.1.1 1.0.0.1}"

  if ip link show dev "$dev" >/dev/null 2>&1; then
    interface_up=true
    ip -4 route show table "$table" default 2>/dev/null | grep -q "default.*dev $dev" && routing_ok=true
    if [ -f "$state_file" ] && [ -s "$state_file" ]; then
      ip -4 rule show 2>/dev/null | grep -q "lookup $table" || rules_ok=false
    elif [ "${warp_domains_count:-0}" -gt 0 ] 2>/dev/null; then
      rules_ok=false
    fi

    if [ -x "$MODDIR/bin/awg" ]; then
      _raw=$(run_with_timeout 2 "$MODDIR/bin/awg" show "$dev" 2>/dev/null) || _raw=""
      endpoint=$(printf '%s\n' "$_raw" | sed -n 's/^endpoint=//p' | head -n1)
      last_handshake=$(printf '%s\n' "$_raw" | sed -n 's/^last_handshake_time_sec=//p' | head -n1)
      rx_bytes=$(printf '%s\n' "$_raw" | sed -n 's/^rx_bytes=//p' | head -n1)
      tx_bytes=$(printf '%s\n' "$_raw" | sed -n 's/^tx_bytes=//p' | head -n1)
      case "$rx_bytes" in ''|*[!0-9]*) rx_bytes=0 ;; esac
      case "$tx_bytes" in ''|*[!0-9]*) tx_bytes=0 ;; esac
    fi
  fi
  [ -n "$endpoint" ] || endpoint="${WARP_ENDPOINT:-162.159.192.1}:${WARP_PORT:-500}"
  [ "$interface_up" = true ] && [ "$routing_ok" = true ] && [ "$last_handshake" -gt 0 ] 2>/dev/null && running=true

  local sip_active=false
  if [ -f "$warp_conf" ]; then
    grep -q '^I1[[:space:]]*=' "$warp_conf" 2>/dev/null && sip_active=true
    _v=$(sed -n 's/^Jc[[:space:]]*=[[:space:]]*//p' "$warp_conf" | head -n1); case "$_v" in ''|*[!0-9]*) ;; *) active_jc="$_v" ;; esac
    _v=$(sed -n 's/^Jmin[[:space:]]*=[[:space:]]*//p' "$warp_conf" | head -n1); case "$_v" in ''|*[!0-9]*) ;; *) active_jmin="$_v" ;; esac
    _v=$(sed -n 's/^Jmax[[:space:]]*=[[:space:]]*//p' "$warp_conf" | head -n1); case "$_v" in ''|*[!0-9]*) ;; *) active_jmax="$_v" ;; esac
  fi
  if [ -f "$adapt_file" ]; then
    _v=$(sed -n 's/^step=//p' "$adapt_file" | head -n1); case "$_v" in ''|*[!0-9]*) ;; *) adapt_step="$_v" ;; esac
    _v=$(sed -n 's/^result=//p' "$adapt_file" | head -n1); case "$_v" in pending|ok|failed) adapt_result="$_v" ;; esac
    _v=$(sed -n 's/^updated=//p' "$adapt_file" | head -n1); case "$_v" in ''|*[!0-9]*) ;; *) adapt_updated="$_v" ;; esac
  fi
  [ "$sip_active" = true ] && adapt_mode=sip || adapt_mode=basic
  now=$(date +%s 2>/dev/null || echo 0); case "$now" in ''|*[!0-9]*) now=0 ;; esac
  if [ "$last_handshake" -gt 0 ] 2>/dev/null && [ "$now" -ge "$last_handshake" ] 2>/dev/null; then handshake_age=$((now-last_handshake)); fi

  local profile_type="Free WARP"
  if [ -f "$MODDIR/state/warp-profile.type" ]; then
    profile_type=$(cat "$MODDIR/state/warp-profile.type" 2>/dev/null | tr -d '\r\n')
  fi

  # AWG98 (Geo) Status
  local geo_dev="${GEO_WARP_DEV:-awg98}" geo_enabled="${ENABLE_GEO_WARP:-1}"
  local geo_running=false geo_if_up=false geo_routing_ok=false geo_endpoint="" geo_rx_bytes=0 geo_tx_bytes=0 geo_last_hs=0 geo_hs_age=-1
  local geo_domains_count=0 geo_profile_type="None"
  geo_domains_count=$(awk '!/^[[:space:]]*(#|$)/ {n++} END {print n+0}' "$LISTS_DIR/geo_warp.list" 2>/dev/null || echo 0)

  if [ -f "$MODDIR/state/geo-profile.type" ]; then
    geo_profile_type=$(cat "$MODDIR/state/geo-profile.type" 2>/dev/null | tr -d '\r\n')
  fi

  if ip link show dev "$geo_dev" >/dev/null 2>&1; then
    geo_if_up=true
    ip -4 route show table "${GEO_WARP_TABLE:-11887}" default 2>/dev/null | grep -q "default.*dev $geo_dev" && geo_routing_ok=true
    if [ -x "$MODDIR/bin/awg" ]; then
      _geo_raw=$(run_with_timeout 2 "$MODDIR/bin/awg" show "$geo_dev" 2>/dev/null) || _geo_raw=""
      geo_endpoint=$(printf '%s\n' "$_geo_raw" | sed -n 's/^endpoint=//p' | head -n1)
      geo_last_hs=$(printf '%s\n' "$_geo_raw" | sed -n 's/^last_handshake_time_sec=//p' | head -n1)
      geo_rx_bytes=$(printf '%s\n' "$_geo_raw" | sed -n 's/^rx_bytes=//p' | head -n1)
      geo_tx_bytes=$(printf '%s\n' "$_geo_raw" | sed -n 's/^tx_bytes=//p' | head -n1)
      case "$geo_rx_bytes" in ''|*[!0-9]*) geo_rx_bytes=0 ;; esac
      case "$geo_tx_bytes" in ''|*[!0-9]*) geo_tx_bytes=0 ;; esac
    fi
  fi
  case "$geo_last_hs" in ''|*[!0-9]*) geo_last_hs=0 ;; esac
  [ "$geo_if_up" = true ] && [ "$geo_routing_ok" = true ] && [ "$geo_last_hs" -gt 0 ] 2>/dev/null && geo_running=true
  if [ "$geo_last_hs" -gt 0 ] 2>/dev/null && [ "$now" -ge "$geo_last_hs" ] 2>/dev/null; then geo_hs_age=$((now-geo_last_hs)); fi

  printf '{"enable_warp":"%s","warp_dev":"%s","running":%s,"interface_up":%s,"routing_ok":%s,"rules_ok":%s,"endpoint":"%s","configured_endpoint":"%s","configured_port":"%s","rx_bytes":%s,"tx_bytes":%s,"last_handshake":%s,"handshake_age":%s,"jc":"%s","jmin":"%s","jmax":"%s","active_jc":"%s","active_jmin":"%s","active_jmax":"%s","adaptive":"%s","sip_force":"%s","adaptive_step":%s,"adaptive_total":%s,"adaptive_result":"%s","adaptive_updated":%s,"adaptive_retry_sec":%s,"adaptive_mode":"%s","s1":"%s","s2":"%s","i1":"%s","i2":"%s","sip_active":%s,"warp_domains":%s,"dns":"%s","dns_force":"%s","profile_type":"%s","enable_geo":"%s","geo_dev":"%s","geo_running":%s,"geo_interface_up":%s,"geo_profile_type":"%s","geo_endpoint":"%s","geo_rx_bytes":%s,"geo_tx_bytes":%s,"geo_last_handshake":%s,"geo_handshake_age":%s,"geo_domains":%s}\n' \
    "$enabled" "$dev" "$running" "$interface_up" "$routing_ok" "$rules_ok" "$(json_escape "$endpoint")" "$(json_escape "${WARP_ENDPOINT:-162.159.192.1}")" "${WARP_PORT:-500}" "${rx_bytes:-0}" "${tx_bytes:-0}" "${last_handshake:-0}" "$handshake_age" "${WARP_JC:-5}" "${WARP_JMIN:-40}" "${WARP_JMAX:-70}" "$active_jc" "$active_jmin" "$active_jmax" "${WARP_ADAPTIVE:-1}" "${WARP_SIP_FORCE:-0}" "$adapt_step" "$adapt_total" "$adapt_result" "$adapt_updated" "${WARP_ADAPT_RETRY_SEC:-300}" "$adapt_mode" "${WARP_S1:-0}" "${WARP_S2:-0}" "$(json_escape "${WARP_I1:-}")" "$(json_escape "${WARP_I2:-}")" "$sip_active" "$warp_domains_count" "$(json_escape "$active_dns")" "${WARP_DNS_FORCE:-1}" \
    "$(json_escape "$profile_type")" \
    "$geo_enabled" "$geo_dev" "$geo_running" "$geo_if_up" "$(json_escape "$geo_profile_type")" "$(json_escape "$geo_endpoint")" "${geo_rx_bytes:-0}" "${geo_tx_bytes:-0}" "${geo_last_hs:-0}" "$geo_hs_age" "$geo_domains_count"
}

cmd_warp_toggle() {
  validate_switch "$2" || return 1
  set_conf ENABLE_WARP "$2" || return 1
  if [ "$2" = "1" ]; then
    spawn_detached sh "$MODDIR/warp-tunnel.sh" start
  else
    sh "$MODDIR/warp-tunnel.sh" stop
  fi
  reload_service
  echo "{\"ok\":true,\"state\":\"$([ "$2" = 1 ] && echo starting || echo stopped)\"}"
}

cmd_warp_restart() {
  if [ "${Z2_ASYNC:-0}" = "1" ]; then
    spawn_detached sh "$MODDIR/warp-tunnel.sh" force-restart
    echo '{"ok":true,"state":"restarting"}'
    return 0
  fi
  sh "$MODDIR/warp-tunnel.sh" force-restart
}

