#!/system/bin/sh
# awg-netmon — Монитор сети и watchdog состояния туннелей (v1.1.2)
# Отслеживает смену сети, деградацию туннеля и восстанавливает сессию
# с ограничением числа попыток и экспоненциальной задержкой.

RUN_DIR="/data/adb/amneziawg/run"
PROFILES_DIR="/data/adb/amneziawg/profiles"
BIN_DIR="${0%/*}"
export PATH="/data/adb/ap/bin:/data/adb/ksu/bin:/data/adb/magisk:$BIN_DIR:/system/bin:/system/xbin:/apex/com.android.runtime/bin:$PATH"
export WG_UAPI_DIR="$RUN_DIR"
export AMNEZIAWG_UAPI_DIR="$RUN_DIR"

# Максимум последовательных неудачных восстановлений до отключения профиля
MAX_FAILS=10
# Возраст хендшейка, после которого сессия считается мертвой
HS_DEAD_AGE=180
# Минимальный исходящий трафик за интервал, при котором отсутствие входящего
# трактуется как односторонний туннель, а не как простой
TX_PROBE_MIN=1024
# Верхняя граница экспоненциальной задержки между попытками
BACKOFF_MAX=600

log_wd() {
  "$BIN_DIR/awg-controller" log-watchdog "$*" >/dev/null 2>&1
}

get_default_phys_iface() {
  local dev
  dev="$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p' | head -n 1)"
  if [ -z "$dev" ]; then
    dev="$(ip route get 8.8.8.8 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p' | head -n 1)"
  fi
  printf '%s' "$dev"
}

get_current_ssid() {
  "$BIN_DIR/awg-controller" get-current-ssid 2>/dev/null
}

read_state() {
  cat "$RUN_DIR/$1" 2>/dev/null
}

# Сброс счетчиков после подтвержденного восстановления обмена
mark_healthy() {
  local p="$1"
  rm -f "$RUN_DIR/${p}.fails" "$RUN_DIR/${p}.nextchk" 2>/dev/null || true
}

# Регистрация неудачи: перезапуск с backoff либо отключение профиля
register_failure() {
  local p="$1"
  local reason="$2"
  local now="$3"

  local nextchk="$(read_state "${p}.nextchk")"
  if [ -n "$nextchk" ] && [ "$now" -lt "$nextchk" ] 2>/dev/null; then
    return 0
  fi

  local fails="$(read_state "${p}.fails")"
  [ -n "$fails" ] || fails=0
  fails=$((fails + 1))
  printf '%s' "$fails" > "$RUN_DIR/${p}.fails"

  if [ $fails -gt $MAX_FAILS ]; then
    log_wd "[$p] Туннель не восстановлен за $MAX_FAILS попыток ($reason). Профиль остановлен, приложения переведены на прямой канал."
    "$BIN_DIR/awg-controller" stop "$p" >/dev/null 2>&1
    : > "$RUN_DIR/${p}.failed"
    rm -f "$RUN_DIR/${p}.fails" "$RUN_DIR/${p}.nextchk" \
          "$RUN_DIR/${p}.rxmark" "$RUN_DIR/${p}.txmark" 2>/dev/null || true
    return 0
  fi

  # Экспоненциальная задержка: 15, 30, 60, 120, 240, 480, далее 600 c
  local backoff=15
  local i=1
  while [ $i -lt $fails ] && [ $backoff -lt $BACKOFF_MAX ]; do
    backoff=$((backoff * 2))
    i=$((i + 1))
  done
  [ $backoff -gt $BACKOFF_MAX ] && backoff=$BACKOFF_MAX
  printf '%s' "$((now + backoff))" > "$RUN_DIR/${p}.nextchk"

  log_wd "[$p] Туннель не отвечает ($reason). Попытка восстановления $fails из $MAX_FAILS, следующая проверка через $backoff c."
  rm -f "$RUN_DIR/${p}.rxmark" "$RUN_DIR/${p}.txmark" 2>/dev/null || true
  "$BIN_DIR/awg-controller" restart "$p" >/dev/null 2>&1
}

check_tunnel_health() {
  local now="$(date +%s)"
  # Перебор идет по списку включенных профилей, а не по файлам *.iface:
  # профиль, который не смог подняться, не имеет .iface и иначе навсегда
  # выпал бы из наблюдения вместо того, чтобы быть восстановленным.
  for p in $("$BIN_DIR/awg-controller" list-enabled 2>/dev/null); do
    [ -n "$p" ] || continue
    [ -f "$RUN_DIR/${p}.paused" ] && continue
    [ -f "$RUN_DIR/${p}.failed" ] && continue
    local ifname="$(cat "$RUN_DIR/${p}.iface" 2>/dev/null)"

    # 1. Профиль не запущен: нет записи об интерфейсе
    if [ -z "$ifname" ]; then
      register_failure "$p" "профиль не запущен" "$now"
      continue
    fi

    # 2. Интерфейс исчез из ядра
    if ! ip link show "$ifname" >/dev/null 2>&1; then
      register_failure "$p" "интерфейс $ifname отсутствует" "$now"
      continue
    fi

    local dump="$("$BIN_DIR/awg" show "$ifname" dump 2>/dev/null)"
    if [ -z "$dump" ]; then
      register_failure "$p" "нет ответа UAPI" "$now"
      continue
    fi

    local rx="$(printf '%s\n' "$dump" | sed -n 's/^rx_bytes=//p' | sort -n | tail -n 1)"
    local tx="$(printf '%s\n' "$dump" | sed -n 's/^tx_bytes=//p' | sort -n | tail -n 1)"
    local hs="$(printf '%s\n' "$dump" | sed -n 's/^last_handshake_time_sec=//p' | sort -n | tail -n 1)"
    [ -n "$rx" ] || rx=0
    [ -n "$tx" ] || tx=0
    [ -n "$hs" ] || hs=0

    local prev_rx="$(read_state "${p}.rxmark")"
    local prev_tx="$(read_state "${p}.txmark")"
    printf '%s' "$rx" > "$RUN_DIR/${p}.rxmark"
    printf '%s' "$tx" > "$RUN_DIR/${p}.txmark"

    # 3. Активная проверка доступности интернета через интерфейс туннеля
    local probe_ip="1.1.1.1"
    local dns_target
    dns_target="$("$BIN_DIR/awg-controller" get-opt-val "$PROFILES_DIR/${p}.json" "custom_dns" "1.1.1.1" 2>/dev/null | awk -F',' '{print $1}' | tr -d ' ')"
    [ -n "$dns_target" ] && [ "$dns_target" != "127.0.0.1" ] && [ "$dns_target" != "192.168.1.1" ] && probe_ip="$dns_target"

    if ! ping -c 1 -W 2 -I "$ifname" "$probe_ip" >/dev/null 2>&1; then
      sleep 1
      if ! ping -c 1 -W 2 -I "$ifname" "$probe_ip" >/dev/null 2>&1; then
        register_failure "$p" "нет ответа сети (100% loss)" "$now"
        continue
      fi
    fi

    # Все проверки пройдены: интерфейс поднят, пинг прошел успешно
    mark_healthy "$p"
  done
}

# Немедленная синхронизация состояния и режима сна при старте монитора
if [ -x "$BIN_DIR/awg-controller" ]; then
  "$BIN_DIR/awg-controller" sync-rules >/dev/null 2>&1
fi

last_iface="$(get_default_phys_iface)"
last_ssid="$(get_current_ssid)"
counter=0

while true; do
  sleep 3
  counter=$((counter + 1))

  cur_iface="$(get_default_phys_iface)"
  cur_ssid="$(get_current_ssid)"

  # Быстрое подтверждение смены сети (1 сек)
  if [ "$cur_iface" != "$last_iface" ] || [ "$cur_ssid" != "$last_ssid" ]; then
    sleep 1
    cur_iface_confirm="$(get_default_phys_iface)"
    cur_ssid_confirm="$(get_current_ssid)"
    if [ "$cur_iface" = "$cur_iface_confirm" ] && [ "$cur_ssid" = "$cur_ssid_confirm" ]; then
      last_iface="$cur_iface"
      last_ssid="$cur_ssid"
      # Условия сети изменились: отключенные профили получают новый шанс
      "$BIN_DIR/awg-controller" reset-failures all >/dev/null 2>&1
      if [ -x "$BIN_DIR/awg-controller" ]; then
        "$BIN_DIR/awg-controller" sync-rules >/dev/null 2>&1
      fi
    fi
  fi

  # Каждые 36 секунд: сначала синхронизация правил (сон в доверенных сетях), затем проверка здоровья
  if [ $((counter % 12)) -eq 0 ]; then
    if [ -x "$BIN_DIR/awg-controller" ]; then
      "$BIN_DIR/awg-controller" sync-rules >/dev/null 2>&1
    fi
    check_tunnel_health
  fi
done
