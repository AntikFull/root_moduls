#!/system/bin/sh
# awg-netmon — Монитор сети, watchdog хендшейка и доверенных сетей (v1.1.1)

RUN_DIR="/data/adb/amneziawg/run"
BIN_DIR="${0%/*}"
export PATH="$BIN_DIR:$PATH"
export WG_UAPI_DIR="$RUN_DIR"
export AMNEZIAWG_UAPI_DIR="$RUN_DIR"

get_default_phys_iface() {
  ip route show table main default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -n 1
}

get_current_ssid() {
  "$BIN_DIR/awg-controller" get-current-ssid 2>/dev/null
}

check_handshake_watchdog() {
  local now="$(date +%s)"
  for iface_file in "$RUN_DIR"/*.iface; do
    [ -f "$iface_file" ] || continue
    local p="$(basename "$iface_file" .iface)"
    [ -f "$RUN_DIR/${p}.paused" ] && continue
    local ifname="$(cat "$iface_file" 2>/dev/null)"
    [ -z "$ifname" ] && continue

    # 1. Проверка существования сетевого интерфейса в системе
    if ! ip link show "$ifname" >/dev/null 2>&1; then
      "$BIN_DIR/awg-controller" restart "$p" >/dev/null 2>&1
      continue
    fi

    # 2. Парсинг UAPI дампа WireGuard/AmneziaWG
    local dump="$("$BIN_DIR/awg" show "$ifname" dump 2>/dev/null)"
    [ -z "$dump" ] && continue

    # Извлечение last_handshake_time_sec из формата key=value
    local last_hs
    last_hs="$(printf '%s\n' "$dump" | sed -n 's/^last_handshake_time_sec=//p' | sort -n | tail -n 1)"

    if [ -n "$last_hs" ] && [ "$last_hs" -gt 0 ] 2>/dev/null; then
      local age=$((now - last_hs))
      if [ $age -gt 180 ]; then
        # Хендшейк устарел (> 180 сек) -> перезапуск туннеля
        "$BIN_DIR/awg-controller" restart "$p" >/dev/null 2>&1
      fi
    else
      # Хендшейк равен 0 (ни разу не завершился успешно). Если процесс запущен > 60 сек назад -> рестарт
      local pid_file="$RUN_DIR/${ifname}.pid"
      if [ -f "$pid_file" ]; then
        local pid_mtime="$(stat -c %Y "$pid_file" 2>/dev/null || echo "$now")"
        if [ $((now - pid_mtime)) -gt 60 ]; then
          "$BIN_DIR/awg-controller" restart "$p" >/dev/null 2>&1
        fi
      fi
    fi
  done
}

last_iface="$(get_default_phys_iface)"
last_ssid="$(get_current_ssid)"
counter=0

while true; do
  sleep 15
  counter=$((counter + 1))

  cur_iface="$(get_default_phys_iface)"
  cur_ssid="$(get_current_ssid)"

  # Гистерезис: подтверждение смены сети повторным замером через 2 секунды
  if [ "$cur_iface" != "$last_iface" ] || [ "$cur_ssid" != "$last_ssid" ]; then
    sleep 2
    cur_iface_confirm="$(get_default_phys_iface)"
    cur_ssid_confirm="$(get_current_ssid)"
    if [ "$cur_iface" = "$cur_iface_confirm" ] && [ "$cur_ssid" = "$cur_ssid_confirm" ]; then
      last_iface="$cur_iface"
      last_ssid="$cur_ssid"
      if [ -x "$BIN_DIR/awg-controller" ]; then
        "$BIN_DIR/awg-controller" sync-rules >/dev/null 2>&1
      fi
    fi
  fi

  # Каждые 30-45 секунд: проверка watchdog хендшейка и синхронизация
  if [ $((counter % 3)) -eq 0 ]; then
    check_handshake_watchdog
    if [ -x "$BIN_DIR/awg-controller" ]; then
      "$BIN_DIR/awg-controller" sync-rules >/dev/null 2>&1
    fi
  fi
done
