#!/system/bin/sh
# Консоль управления Zapret2 eCubz и запуск локального WebUI.

MODDIR="/data/adb/modules/zapret2-android"
[ -d "$MODDIR" ] || MODDIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
CONF_FILE="$MODDIR/zapret2.conf"
APPS_LIST="$MODDIR/apps.list"
EXCLUDE_LIST="$MODDIR/exclude.list"
AUTO_DOMAINS_FILE="$MODDIR/auto_domains.list"
EXCLUDE_DOMAINS_FILE="$MODDIR/exclude_domains.list"
FORCE_TCP_APPS_LIST="$MODDIR/force_tcp_apps.list"
LOG_FILE="$MODDIR/zapret2.log"
WEBROOT="$MODDIR/webroot"
RUN_DIR="$MODDIR/run"
WEB_PID_FILE="$RUN_DIR/webui.pid"

load_conf() { [ -f "$CONF_FILE" ] && . "$CONF_FILE"; : "${WEBUI_PORT:=18080}"; }
reload_service() { sh "$MODDIR/service.sh" reload; }

validate_pkg() {
  case "$1" in *[!A-Za-z0-9_.]*|'') return 1 ;; *) return 0 ;; esac
}

set_conf() {
  local key="$1" value="$2"
  grep -q "^$key=" "$CONF_FILE" 2>/dev/null && sed -i "s|^$key=.*|$key=\"$value\"|" "$CONF_FILE" || echo "$key=\"$value\"" >> "$CONF_FILE"
}

list_file() {
  case "$1" in
    apps) echo "$APPS_LIST" ;; exclude) echo "$EXCLUDE_LIST" ;;
    auto-domains) echo "$AUTO_DOMAINS_FILE" ;; exclude-domains) echo "$EXCLUDE_DOMAINS_FILE" ;;
    force-tcp) echo "$FORCE_TCP_APPS_LIST" ;; *) return 1 ;;
  esac
}

cmd_status() {
  load_conf
  local pid=0 state="ОСТАНОВЛЕН"
  [ -f "$RUN_DIR/nfqws2.pid" ] && pid=$(cat "$RUN_DIR/nfqws2.pid" 2>/dev/null)
  [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && kill -0 "$pid" 2>/dev/null && state="РАБОТАЕТ"
  echo "Zapret2: $state (PID: ${pid:-0})"
  echo "MODE=${MODE:-EXCLUDE}, FORCE_TCP=${FORCE_TCP:-0}, QUIC_MODE=${QUIC_MODE:-SELECTED}"
  echo "WebUI: KernelSU manager"
}

cmd_json_status() {
  load_conf
  local pid=0 running=false apps=0 excluded=0
  [ -f "$RUN_DIR/nfqws2.pid" ] && pid=$(cat "$RUN_DIR/nfqws2.pid" 2>/dev/null)
  [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && kill -0 "$pid" 2>/dev/null && running=true || pid=0
  [ -f "$APPS_LIST" ] && apps=$(grep -cv '^[[:space:]]*\(#\|$\)' "$APPS_LIST")
  [ -f "$EXCLUDE_LIST" ] && excluded=$(grep -cv '^[[:space:]]*\(#\|$\)' "$EXCLUDE_LIST")
  printf '{"running":%s,"pid":%s,"mode":"%s","force_tcp":"%s","quic_mode":"%s","apps_count":%s,"exclude_count":%s}\n' "$running" "$pid" "${MODE:-EXCLUDE}" "${FORCE_TCP:-0}" "${QUIC_MODE:-SELECTED}" "$apps" "$excluded"
}

cmd_json_apps() {
  pm list packages -U 2>/dev/null | awk -v inc="$APPS_LIST" -v exc="$EXCLUDE_LIST" '
    BEGIN { while ((getline l < inc)>0) if (l !~ /^#/ && l!="") a[l]=1; close(inc); while ((getline l < exc)>0) if (l !~ /^#/ && l!="") e[l]=1; close(exc); print "["; first=1 }
    { line=$0; sub(/^package:/,"",line); split(line,p," uid:"); count=split(p[1],parts,"="); pkg=parts[count]; if(pkg!="") { if(!first) printf ","; first=0; printf "{\"pkg\":\"%s\",\"include\":%s,\"exclude\":%s}",pkg,(pkg in a)?"true":"false",(pkg in e)?"true":"false" } }
    END { print "]" }'
}

cmd_add_del() {
  local list="$1" op="$2" pkg="$3" file
  validate_pkg "$pkg" || { echo "Недопустимое имя пакета"; return 1; }
  file=$(list_file "$list") || return 1
  if [ "$op" = add ]; then grep -qxF "$pkg" "$file" 2>/dev/null || echo "$pkg" >> "$file"; else sed -i "\|^$pkg$|d" "$file"; fi
  reload_service
}

cmd_replace_list() {
  local list="$1" input="$2" file tmp line
  file=$(list_file "$list") || return 1
  tmp="$file.tmp.$$"
  : > "$tmp" || return 1
  printf '%s\n' "$input" | while read -r line || [ -n "$line" ]; do
    case "$line" in *[!A-Za-z0-9._#\ -]* ) exit 1 ;; esac
    echo "$line"
  done > "$tmp" || { rm -f "$tmp"; echo "Недопустимые символы в списке"; return 1; }
  mv -f "$tmp" "$file"
  reload_service
}

cmd_webui() { echo "WebUI предоставляется менеджером KernelSU через webroot/index.html"; }

case "$1" in
  status) cmd_status ;; json-status) cmd_json_status ;; json-apps) cmd_json_apps ;;
  mode) case "$2" in include|exclude|global) set_conf MODE "$(echo "$2" | tr '[:lower:]' '[:upper:]')"; reload_service ;; *) exit 1 ;; esac ;;
  forcetcp) [ "$2" = 0 ] || [ "$2" = 1 ] || exit 1; set_conf FORCE_TCP "$2"; reload_service ;;
  quicmode) case "$2" in off|selected|global) set_conf QUIC_MODE "$(echo "$2" | tr '[:lower:]' '[:upper:]')"; reload_service ;; *) exit 1 ;; esac ;;
  settings) case "$2:$3:$4" in include:off:0|include:off:1|include:selected:0|include:selected:1|include:global:0|include:global:1|exclude:off:0|exclude:off:1|exclude:selected:0|exclude:selected:1|exclude:global:0|exclude:global:1|global:off:0|global:off:1|global:selected:0|global:selected:1|global:global:0|global:global:1) set_conf MODE "$(echo "$2" | tr '[:lower:]' '[:upper:]')"; set_conf QUIC_MODE "$(echo "$3" | tr '[:lower:]' '[:upper:]')"; set_conf FORCE_TCP "$4"; reload_service ;; *) exit 1 ;; esac ;;
  add) cmd_add_del apps add "$2" ;; del) cmd_add_del apps del "$2" ;;
  add-exclude) cmd_add_del exclude add "$2" ;; del-exclude) cmd_add_del exclude del "$2" ;;
  replace-list) cmd_replace_list "$2" "$3" ;;
  restart) reload_service ;; webui) cmd_webui ;; log) tail -n 100 "$LOG_FILE" 2>/dev/null ;;
  *) echo "Команды: status, mode, forcetcp, quicmode, add, del, add-exclude, del-exclude, replace-list, restart, webui, log" ;;
esac
